service: iot-shadow-management

frameworkVersion: '3'

provider:
  name: aws
  runtime: nodejs18.x
  region: ${opt:region, 'us-east-1'}
  stage: ${opt:stage, 'dev'}
  memorySize: 256
  timeout: 30

  # Environment variables for all functions
  environment:
    STAGE: ${self:provider.stage}
    REGION: ${self:provider.region}
    DEVICE_TABLE: ${self:custom.deviceTable}
    SHADOW_HISTORY_TABLE: ${self:custom.shadowHistoryTable}
    PROVISIONING_LOGS_TABLE: ${self:custom.provisioningLogsTable}
    FLEET_ANALYTICS_TABLE: ${self:custom.fleetAnalyticsTable}
    GREENGRASS_DEPLOYMENTS_TABLE: ${self:custom.greengrassDeploymentsTable}
    IOT_ENDPOINT: !GetAtt IotEndpoint.endpointAddress
    SNS_ALERT_TOPIC_ARN: !Ref DeviceAlertTopic

  # IAM Role for Lambda functions
  iam:
    role:
      statements:
        # DynamoDB permissions
        - Effect: Allow
          Action:
            - dynamodb:Query
            - dynamodb:Scan
            - dynamodb:GetItem
            - dynamodb:PutItem
            - dynamodb:UpdateItem
            - dynamodb:DeleteItem
          Resource:
            - !GetAtt DeviceRegistryTable.Arn
            - !GetAtt ShadowHistoryTable.Arn
            - !GetAtt ProvisioningLogsTable.Arn
            - !GetAtt FleetAnalyticsTable.Arn
            - !GetAtt GreengrassDeploymentsTable.Arn
            - !Sub '${DeviceRegistryTable.Arn}/index/*'
            - !Sub '${ShadowHistoryTable.Arn}/index/*'
            - !Sub '${FleetAnalyticsTable.Arn}/index/*'
            - !Sub '${GreengrassDeploymentsTable.Arn}/index/*'

        # IoT permissions
        - Effect: Allow
          Action:
            - iot:CreateThing
            - iot:DescribeThing
            - iot:UpdateThing
            - iot:ListThings
            - iot:CreateThingGroup
            - iot:AddThingToThingGroup
            - iot:RemoveThingFromThingGroup
            - iot:ListThingGroups
            - iot:ListThingsInThingGroup
            - iot:DescribeThingGroup
            - iot:DeleteThingGroup
            - iot:UpdateThingGroup
            - iot:CreateThingType
            - iot:ListThingTypes
            - iot:DescribeThingType
            - iot:DeleteThingType
            - iot:DeprecateThingType
            - iot:UpdateThingShadow
            - iot:GetThingShadow
            - iot:DeleteThingShadow
            - iot:ListThingShadows
            - iot:Publish
            - iot:AttachThingPrincipal
            - iot:DetachThingPrincipal
            - iot:AttachPolicy
            - iot:DetachPolicy
            - iot:CreatePolicy
            - iot:CreateCertificateFromCsr
          Resource: '*'

        # CloudWatch Logs
        - Effect: Allow
          Action:
            - logs:CreateLogGroup
            - logs:CreateLogStream
            - logs:PutLogEvents
          Resource: '*'

        # SNS permissions
        - Effect: Allow
          Action:
            - sns:Publish
          Resource: !Ref DeviceAlertTopic

        # Greengrass permissions
        - Effect: Allow
          Action:
            - greengrass:CreateDeployment
            - greengrass:GetDeployment
            - greengrass:ListDeployments
            - greengrass:CancelDeployment
            - greengrass:GetCoreDevice
            - greengrass:ListCoreDevices
            - greengrass:GetComponent
            - greengrass:ListComponents
            - greengrass:ListInstalledComponents
            - greengrass:ListEffectiveDeployments
          Resource: '*'

custom:
  # Table names
  deviceTable: ${self:service}-devices-${self:provider.stage}
  shadowHistoryTable: ${self:service}-shadow-history-${self:provider.stage}
  provisioningLogsTable: ${self:service}-provisioning-logs-${self:provider.stage}
  fleetAnalyticsTable: ${self:service}-fleet-analytics-${self:provider.stage}
  greengrassDeploymentsTable: ${self:service}-greengrass-deployments-${self:provider.stage}

  # Fleet Provisioning
  provisioningTemplateName: ${self:service}-template-${self:provider.stage}
  provisioningRoleName: ${self:service}-provisioning-role-${self:provider.stage}
  claimPolicyName: ${self:service}-claim-policy-${self:provider.stage}
  devicePolicyName: ${self:service}-device-policy-${self:provider.stage}

functions:
  # Fleet Provisioning Pre-Hook
  preProvisioningHook:
    handler: src/handlers/provisioning/preProvisioningHook.handler
    description: Validates device before provisioning
    events:
      - iot:
          sql: "SELECT * FROM '$aws/provisioning-templates/${self:custom.provisioningTemplateName}/provision/json'"
          enabled: true
    environment:
      PROVISIONING_TEMPLATE: ${self:custom.provisioningTemplateName}

  # Fleet Provisioning Post-Hook (optional)
  postProvisioningHook:
    handler: src/handlers/provisioning/postProvisioningHook.handler
    description: Performs actions after successful provisioning
    environment:
      PROVISIONING_TEMPLATE: ${self:custom.provisioningTemplateName}

  # Shadow Update Handler
  shadowUpdateHandler:
    handler: src/handlers/shadow/shadowUpdateHandler.handler
    description: Processes shadow update events
    events:
      - iot:
          sql: "SELECT *, topic(3) as thingName FROM '$aws/things/+/shadow/update/accepted'"
          enabled: true
      - iot:
          sql: "SELECT *, topic(3) as thingName, topic(5) as shadowName FROM '$aws/things/+/shadow/name/+/update/accepted'"
          enabled: true

  # Shadow Delta Handler
  shadowDeltaHandler:
    handler: src/handlers/shadow/shadowDeltaHandler.handler
    description: Processes shadow delta events
    events:
      - iot:
          sql: "SELECT *, topic(3) as thingName FROM '$aws/things/+/shadow/update/delta'"
          enabled: true

  # Device Management API
  createDevice:
    handler: src/handlers/api/createDevice.handler
    description: Creates a new device manually (non-provisioning)
    events:
      - http:
          path: /devices
          method: post
          cors: true

  getDevice:
    handler: src/handlers/api/getDevice.handler
    description: Gets device information
    events:
      - http:
          path: /devices/{deviceId}
          method: get
          cors: true

  listDevices:
    handler: src/handlers/api/listDevices.handler
    description: Lists all devices
    events:
      - http:
          path: /devices
          method: get
          cors: true

  updateDeviceShadow:
    handler: src/handlers/api/updateDeviceShadow.handler
    description: Updates device shadow from API
    events:
      - http:
          path: /devices/{deviceId}/shadow
          method: put
          cors: true

  getDeviceShadow:
    handler: src/handlers/api/getDeviceShadow.handler
    description: Gets device shadow
    events:
      - http:
          path: /devices/{deviceId}/shadow
          method: get
          cors: true

  getShadowHistory:
    handler: src/handlers/api/getShadowHistory.handler
    description: Gets shadow update history
    events:
      - http:
          path: /devices/{deviceId}/shadow/history
          method: get
          cors: true

  # Fleet Analytics Functions
  fleetAnalyticsAggregator:
    handler: src/handlers/analytics/fleetAnalyticsAggregator.handler
    description: Aggregates fleet metrics from device stream
    events:
      - stream:
          type: dynamodb
          arn: !GetAtt DeviceRegistryTable.StreamArn
          batchSize: 10
          startingPosition: LATEST
          maximumRetryAttempts: 3

  getFleetAnalytics:
    handler: src/handlers/api/getFleetAnalytics.handler
    description: Gets fleet-wide analytics
    events:
      - http:
          path: /analytics/fleet
          method: get
          cors: true

  getDeviceMetrics:
    handler: src/handlers/api/getDeviceMetrics.handler
    description: Gets metrics for specific device
    events:
      - http:
          path: /analytics/devices/{deviceId}/metrics
          method: get
          cors: true

  # SNS Alert Functions
  deviceAlertHandler:
    handler: src/handlers/alerts/deviceAlertHandler.handler
    description: Processes device alerts and sends SNS notifications
    events:
      - stream:
          type: dynamodb
          arn: !GetAtt ShadowHistoryTable.StreamArn
          batchSize: 10
          startingPosition: LATEST
          maximumRetryAttempts: 3

  # Greengrass Deployment Functions
  createGreengrassDeployment:
    handler: src/handlers/greengrass/createDeployment.handler
    description: Creates a new Greengrass deployment
    events:
      - http:
          path: /greengrass/deployments
          method: post
          cors: true

  getGreengrassDeployment:
    handler: src/handlers/greengrass/getDeployment.handler
    description: Gets Greengrass deployment status
    events:
      - http:
          path: /greengrass/deployments/{deploymentId}
          method: get
          cors: true

  listGreengrassDeployments:
    handler: src/handlers/greengrass/listDeployments.handler
    description: Lists all Greengrass deployments
    events:
      - http:
          path: /greengrass/deployments
          method: get
          cors: true

  cancelGreengrassDeployment:
    handler: src/handlers/greengrass/cancelDeployment.handler
    description: Cancels a Greengrass deployment
    events:
      - http:
          path: /greengrass/deployments/{deploymentId}
          method: delete
          cors: true

  # Thing Type Management Functions
  createThingType:
    handler: src/handlers/thing-types/createThingType.handler
    description: Creates a new Thing Type dynamically
    events:
      - http:
          path: /thing-types
          method: post
          cors: true

  listThingTypes:
    handler: src/handlers/thing-types/listThingTypes.handler
    description: Lists all Thing Types
    events:
      - http:
          path: /thing-types
          method: get
          cors: true

  getThingType:
    handler: src/handlers/thing-types/getThingType.handler
    description: Gets Thing Type details
    events:
      - http:
          path: /thing-types/{thingTypeName}
          method: get
          cors: true

  deleteThingType:
    handler: src/handlers/thing-types/deleteThingType.handler
    description: Deletes a Thing Type
    events:
      - http:
          path: /thing-types/{thingTypeName}
          method: delete
          cors: true

  # Thing Group Management Functions
  createThingGroup:
    handler: src/handlers/thing-groups/createThingGroup.handler
    description: Creates a new Thing Group dynamically
    events:
      - http:
          path: /thing-groups
          method: post
          cors: true

  listThingGroups:
    handler: src/handlers/thing-groups/listThingGroups.handler
    description: Lists all Thing Groups
    events:
      - http:
          path: /thing-groups
          method: get
          cors: true

  getThingGroup:
    handler: src/handlers/thing-groups/getThingGroup.handler
    description: Gets Thing Group details
    events:
      - http:
          path: /thing-groups/{thingGroupName}
          method: get
          cors: true

  deleteThingGroup:
    handler: src/handlers/thing-groups/deleteThingGroup.handler
    description: Deletes a Thing Group
    events:
      - http:
          path: /thing-groups/{thingGroupName}
          method: delete
          cors: true

  addThingToGroup:
    handler: src/handlers/thing-groups/addThingToGroup.handler
    description: Adds or removes a thing from a thing group
    events:
      - http:
          path: /thing-groups/{thingGroupName}/things/{thingName}
          method: put
          cors: true
      - http:
          path: /thing-groups/{thingGroupName}/things/{thingName}
          method: delete
          cors: true

resources:
  Resources:
    # DynamoDB Tables
    DeviceRegistryTable:
      Type: AWS::DynamoDB::Table
      Properties:
        TableName: ${self:custom.deviceTable}
        BillingMode: PAY_PER_REQUEST
        AttributeDefinitions:
          - AttributeName: deviceId
            AttributeType: S
          - AttributeName: thingName
            AttributeType: S
          - AttributeName: status
            AttributeType: S
        KeySchema:
          - AttributeName: deviceId
            KeyType: HASH
        GlobalSecondaryIndexes:
          - IndexName: thingName-index
            KeySchema:
              - AttributeName: thingName
                KeyType: HASH
            Projection:
              ProjectionType: ALL
          - IndexName: status-index
            KeySchema:
              - AttributeName: status
                KeyType: HASH
            Projection:
              ProjectionType: ALL
        StreamSpecification:
          StreamViewType: NEW_AND_OLD_IMAGES
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    ShadowHistoryTable:
      Type: AWS::DynamoDB::Table
      Properties:
        TableName: ${self:custom.shadowHistoryTable}
        BillingMode: PAY_PER_REQUEST
        AttributeDefinitions:
          - AttributeName: thingName
            AttributeType: S
          - AttributeName: timestamp
            AttributeType: N
        KeySchema:
          - AttributeName: thingName
            KeyType: HASH
          - AttributeName: timestamp
            KeyType: RANGE
        StreamSpecification:
          StreamViewType: NEW_AND_OLD_IMAGES
        TimeToLiveSpecification:
          AttributeName: ttl
          Enabled: true
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    ProvisioningLogsTable:
      Type: AWS::DynamoDB::Table
      Properties:
        TableName: ${self:custom.provisioningLogsTable}
        BillingMode: PAY_PER_REQUEST
        AttributeDefinitions:
          - AttributeName: requestId
            AttributeType: S
          - AttributeName: timestamp
            AttributeType: N
          - AttributeName: deviceId
            AttributeType: S
        KeySchema:
          - AttributeName: requestId
            KeyType: HASH
          - AttributeName: timestamp
            KeyType: RANGE
        GlobalSecondaryIndexes:
          - IndexName: deviceId-index
            KeySchema:
              - AttributeName: deviceId
                KeyType: HASH
              - AttributeName: timestamp
                KeyType: RANGE
            Projection:
              ProjectionType: ALL
        TimeToLiveSpecification:
          AttributeName: ttl
          Enabled: true
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    FleetAnalyticsTable:
      Type: AWS::DynamoDB::Table
      Properties:
        TableName: ${self:custom.fleetAnalyticsTable}
        BillingMode: PAY_PER_REQUEST
        AttributeDefinitions:
          - AttributeName: metricId
            AttributeType: S
          - AttributeName: timestamp
            AttributeType: N
          - AttributeName: metricType
            AttributeType: S
        KeySchema:
          - AttributeName: metricId
            KeyType: HASH
          - AttributeName: timestamp
            KeyType: RANGE
        GlobalSecondaryIndexes:
          - IndexName: metricType-timestamp-index
            KeySchema:
              - AttributeName: metricType
                KeyType: HASH
              - AttributeName: timestamp
                KeyType: RANGE
            Projection:
              ProjectionType: ALL
        TimeToLiveSpecification:
          AttributeName: ttl
          Enabled: true
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    GreengrassDeploymentsTable:
      Type: AWS::DynamoDB::Table
      Properties:
        TableName: ${self:custom.greengrassDeploymentsTable}
        BillingMode: PAY_PER_REQUEST
        AttributeDefinitions:
          - AttributeName: deploymentId
            AttributeType: S
          - AttributeName: createdAt
            AttributeType: N
          - AttributeName: status
            AttributeType: S
        KeySchema:
          - AttributeName: deploymentId
            KeyType: HASH
          - AttributeName: createdAt
            KeyType: RANGE
        GlobalSecondaryIndexes:
          - IndexName: status-createdAt-index
            KeySchema:
              - AttributeName: status
                KeyType: HASH
              - AttributeName: createdAt
                KeyType: RANGE
            Projection:
              ProjectionType: ALL
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    # SNS Topic for Device Alerts
    DeviceAlertTopic:
      Type: AWS::SNS::Topic
      Properties:
        TopicName: ${self:service}-device-alerts-${self:provider.stage}
        DisplayName: IoT Device Alert Notifications
        Tags:
          - Key: Service
            Value: ${self:service}
          - Key: Stage
            Value: ${self:provider.stage}

    # IoT Provisioning Role
    ProvisioningRole:
      Type: AWS::IAM::Role
      Properties:
        RoleName: ${self:custom.provisioningRoleName}
        AssumeRolePolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Principal:
                Service: iot.amazonaws.com
              Action: sts:AssumeRole
        ManagedPolicyArns:
          - arn:aws:iam::aws:policy/service-role/AWSIoTThingsRegistration
        Policies:
          - PolicyName: ProvisioningPolicy
            PolicyDocument:
              Version: '2012-10-17'
              Statement:
                - Effect: Allow
                  Action:
                    - iot:CreateThing
                    - iot:CreateCertificateFromCsr
                    - iot:AttachThingPrincipal
                    - iot:AttachPolicy
                    - iot:DescribeCertificate
                    - iot:UpdateCertificate
                  Resource: '*'

    # Claim Certificate Policy (used before provisioning)
    ClaimCertificatePolicy:
      Type: AWS::IoT::Policy
      Properties:
        PolicyName: ${self:custom.claimPolicyName}
        PolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Action:
                - iot:Connect
              Resource: '*'
            - Effect: Allow
              Action:
                - iot:Publish
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/$aws/certificates/create/json'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/$aws/provisioning-templates/${self:custom.provisioningTemplateName}/provision/json'
            - Effect: Allow
              Action:
                - iot:Receive
              Resource: '*'
            - Effect: Allow
              Action:
                - iot:Subscribe
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/certificates/create/json/accepted'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/certificates/create/json/rejected'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/provisioning-templates/${self:custom.provisioningTemplateName}/provision/json/accepted'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/provisioning-templates/${self:custom.provisioningTemplateName}/provision/json/rejected'

    # Device Policy (used after provisioning)
    DevicePolicy:
      Type: AWS::IoT::Policy
      Properties:
        PolicyName: ${self:custom.devicePolicyName}
        PolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Action:
                - iot:Connect
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:client/$${iot:Connection.Thing.ThingName}'
            - Effect: Allow
              Action:
                - iot:Publish
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/$aws/things/$${iot:Connection.Thing.ThingName}/shadow/*'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/device/$${iot:Connection.Thing.ThingName}/*'
            - Effect: Allow
              Action:
                - iot:Subscribe
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/things/$${iot:Connection.Thing.ThingName}/shadow/*'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topicfilter/$aws/things/$${iot:Connection.Thing.ThingName}/jobs/*'
            - Effect: Allow
              Action:
                - iot:Receive
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/$aws/things/$${iot:Connection.Thing.ThingName}/shadow/*'
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:topic/$aws/things/$${iot:Connection.Thing.ThingName}/jobs/*'
            - Effect: Allow
              Action:
                - iot:UpdateThingShadow
                - iot:GetThingShadow
                - iot:DeleteThingShadow
              Resource:
                - !Sub 'arn:aws:iot:${AWS::Region}:${AWS::AccountId}:thing/$${iot:Connection.Thing.ThingName}'

    # Fleet Provisioning Template
    ProvisioningTemplate:
      Type: AWS::IoT::ProvisioningTemplate
      Properties:
        TemplateName: ${self:custom.provisioningTemplateName}
        Description: Fleet provisioning template for IoT devices
        Enabled: true
        ProvisioningRoleArn: !GetAtt ProvisioningRole.Arn
        PreProvisioningHook:
          TargetArn: !GetAtt PreProvisioningHookLambdaFunction.Arn
          PayloadVersion: '2020-04-01'
        TemplateBody: !Sub |
          {
            "Parameters": {
              "SerialNumber": {
                "Type": "String"
              },
              "DeviceType": {
                "Type": "String"
              },
              "AWS::IoT::Certificate::Id": {
                "Type": "String"
              }
            },
            "Resources": {
              "thing": {
                "Type": "AWS::IoT::Thing",
                "Properties": {
                  "ThingName": {
                    "Fn::Join": [
                      "-",
                      [
                        {"Ref": "DeviceType"},
                        {"Ref": "SerialNumber"}
                      ]
                    ]
                  },
                  "AttributePayload": {
                    "serialNumber": {"Ref": "SerialNumber"},
                    "deviceType": {"Ref": "DeviceType"}
                  },
                  "ThingTypeName": {"Ref": "DeviceType"}
                }
              },
              "certificate": {
                "Type": "AWS::IoT::Certificate",
                "Properties": {
                  "CertificateId": {"Ref": "AWS::IoT::Certificate::Id"},
                  "Status": "Active"
                }
              },
              "policy": {
                "Type": "AWS::IoT::Policy",
                "Properties": {
                  "PolicyName": "${self:custom.devicePolicyName}"
                }
              }
            }
          }

    # Lambda Permission for IoT to invoke Pre-Provisioning Hook
    PreProvisioningHookPermission:
      Type: AWS::Lambda::Permission
      Properties:
        FunctionName: !GetAtt PreProvisioningHookLambdaFunction.Arn
        Action: lambda:InvokeFunction
        Principal: iot.amazonaws.com
        SourceArn: !GetAtt ProvisioningTemplate.TemplateArn

    # Thing Types
    SensorThingType:
      Type: AWS::IoT::ThingType
      Properties:
        ThingTypeName: Sensor
        ThingTypeProperties:
          ThingTypeDescription: IoT Sensor Device
          SearchableAttributes:
            - model
            - location
            - version

    GatewayThingType:
      Type: AWS::IoT::ThingType
      Properties:
        ThingTypeName: Gateway
        ThingTypeProperties:
          ThingTypeDescription: IoT Gateway Device
          SearchableAttributes:
            - model
            - location
            - version

    ActuatorThingType:
      Type: AWS::IoT::ThingType
      Properties:
        ThingTypeName: Actuator
        ThingTypeProperties:
          ThingTypeDescription: IoT Actuator Device
          SearchableAttributes:
            - model
            - location
            - version

    # Thing Groups
    ProductionThingGroup:
      Type: AWS::IoT::ThingGroup
      Properties:
        ThingGroupName: production
        ThingGroupProperties:
          ThingGroupDescription: Production devices

    # Custom resource to get IoT endpoint
    IotEndpoint:
      Type: Custom::IotEndpoint
      Properties:
        ServiceToken: !GetAtt GetIotEndpointFunction.Arn

    GetIotEndpointFunction:
      Type: AWS::Lambda::Function
      Properties:
        FunctionName: ${self:service}-get-iot-endpoint-${self:provider.stage}
        Runtime: nodejs18.x
        Handler: index.handler
        Role: !GetAtt GetIotEndpointFunctionRole.Arn
        Code:
          ZipFile: |
            const { IoTClient, DescribeEndpointCommand } = require('@aws-sdk/client-iot');
            const response = require('cfn-response');

            exports.handler = async (event, context) => {
              console.log('Event:', JSON.stringify(event, null, 2));

              if (event.RequestType === 'Delete') {
                await response.send(event, context, response.SUCCESS);
                return;
              }

              try {
                const iot = new IoTClient({});
                const result = await iot.send(new DescribeEndpointCommand({ endpointType: 'iot:Data-ATS' }));

                await response.send(event, context, response.SUCCESS, {
                  endpointAddress: result.endpointAddress
                });
              } catch (error) {
                console.error('Error:', error);
                await response.send(event, context, response.FAILED, { Error: error.message });
              }
            };

    GetIotEndpointFunctionRole:
      Type: AWS::IAM::Role
      Properties:
        AssumeRolePolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Principal:
                Service: lambda.amazonaws.com
              Action: sts:AssumeRole
        ManagedPolicyArns:
          - arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole
        Policies:
          - PolicyName: IotDescribeEndpoint
            PolicyDocument:
              Version: '2012-10-17'
              Statement:
                - Effect: Allow
                  Action:
                    - iot:DescribeEndpoint
                  Resource: '*'

  Outputs:
    DeviceTableName:
      Description: Device Registry DynamoDB Table
      Value: !Ref DeviceRegistryTable
      Export:
        Name: ${self:service}-${self:provider.stage}-DeviceTable

    ShadowHistoryTableName:
      Description: Shadow History DynamoDB Table
      Value: !Ref ShadowHistoryTable
      Export:
        Name: ${self:service}-${self:provider.stage}-ShadowHistoryTable

    ProvisioningTemplateName:
      Description: Fleet Provisioning Template Name
      Value: ${self:custom.provisioningTemplateName}
      Export:
        Name: ${self:service}-${self:provider.stage}-ProvisioningTemplate

    ClaimPolicyName:
      Description: Claim Certificate Policy Name
      Value: !Ref ClaimCertificatePolicy
      Export:
        Name: ${self:service}-${self:provider.stage}-ClaimPolicy

    DevicePolicyName:
      Description: Device Policy Name
      Value: !Ref DevicePolicy
      Export:
        Name: ${self:service}-${self:provider.stage}-DevicePolicy

    IoTEndpoint:
      Description: IoT Core Endpoint
      Value: !GetAtt IotEndpoint.endpointAddress
      Export:
        Name: ${self:service}-${self:provider.stage}-IoTEndpoint

    ApiEndpoint:
      Description: API Gateway Endpoint
      Value: !Sub 'https://${ApiGatewayRestApi}.execute-api.${AWS::Region}.amazonaws.com/${self:provider.stage}'
      Export:
        Name: ${self:service}-${self:provider.stage}-ApiEndpoint

    FleetAnalyticsTableName:
      Description: Fleet Analytics DynamoDB Table
      Value: !Ref FleetAnalyticsTable
      Export:
        Name: ${self:service}-${self:provider.stage}-FleetAnalyticsTable

    GreengrassDeploymentsTableName:
      Description: Greengrass Deployments DynamoDB Table
      Value: !Ref GreengrassDeploymentsTable
      Export:
        Name: ${self:service}-${self:provider.stage}-GreengrassDeploymentsTable

    DeviceAlertTopicArn:
      Description: SNS Topic ARN for Device Alerts
      Value: !Ref DeviceAlertTopic
      Export:
        Name: ${self:service}-${self:provider.stage}-DeviceAlertTopic

plugins:
  - serverless-offline
  - serverless-iot-local
