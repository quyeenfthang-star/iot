{
  "name": "iot-shadow-management",
  "version": "1.0.0",
  "description": "AWS IoT Shadow Management with Fleet Provisioning, Fleet Analytics, and Greengrass Deployment Manager",
  "main": "index.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "logs": "serverless logs -f",
    "offline": "serverless offline",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/"
  },
  "keywords": [
    "aws",
    "iot",
    "shadow",
    "fleet-provisioning",
    "greengrass",
    "analytics",
    "fleet-management",
    "serverless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-greengrassv2": "^3.450.0",
    "@aws-sdk/client-iot": "^3.450.0",
    "@aws-sdk/client-iot-data-plane": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "serverless": "^3.38.0",
    "serverless-iot-local": "^0.1.0",
    "serverless-offline": "^13.3.0"
  }
